# Copy this file to .env and replace the placeholder password with a local,
# URL-safe random value. Use the same value in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_USER=pulse
POSTGRES_PASSWORD=replace_with_a_local_random_password
POSTGRES_DB=pulse
POSTGRES_PORT=54329

# Used by NestJS when running on the host. Compose overrides the hostname to
# reach its private PostgreSQL service.
DATABASE_URL=postgresql://pulse:replace_with_a_local_random_password@localhost:54329/pulse?schema=public
PORT=3000
API_PORT=3000

# Exact origins only; no wildcard. Add a deployed origin only when it is needed.
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,http://tauri.localhost
